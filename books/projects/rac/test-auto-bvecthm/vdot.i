    enum { N0 = (W+31)/32, M = ((N0) < (Na) ? (N0) : (Na)) };
    ac_int<M*32,false> res = 0;
    for(int i=0; i < M; i++)
      res.set_slc(i*32, ac_int<32>(ivec[bigendian ? M-1-i : i]));
    *this = res;
  }
