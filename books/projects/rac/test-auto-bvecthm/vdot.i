// This fonction is used to transform benc's output (a value) to the encoding
// used by the RTL.
ui4 adapt_encoding(int x) {
  ui4 pp = 0;
  pp[0] = x == 1; // * +1
  pp[1] = x == 2; // * +2
  pp[2] = x == -1; // * -1
  pp[3] = x == -2; // * -2
  return pp;
}

