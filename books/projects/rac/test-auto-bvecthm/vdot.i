    // Asserts if anything other than 0-9a-fA-F is encountered
    ac_int<W,S> res = 0;
    while(*str) {
      char c = *str;
      int h = 0;
      if(c >= '0' && c <= '9')
        h = c - '0';
      else if(c >= 'A' && c <= 'F')
        h = c - 'A' + 10;
      else if(c >= 'a' && c <= 'f')
