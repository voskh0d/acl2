  ui128 res = 0;

  if (size) {
    if (sel_4ways) {
      res = lane1_res.slc<64>(0);
      if (quad_result) {
        res.set_slc(64, lane3_res.slc<64>(0));
      }
    } else {
      res.set_slc(0, ui32(lane1_res));
      res.set_slc(32, ui32(lane2_res));
      if (quad_result) {
        res.set_slc(64, ui32(lane3_res));
        res.set_slc(96, ui32(lane4_res));
      }
    }
  } else {
    res = lane1_res.slc<32>(0);
    res.set_slc(32, ui32(lane2_res));

    if (quad_result) {
      res.set_slc(64, ui32(lane3_res));
      res.set_slc(96, ui32(lane4_res));
    }
  }

  return res;
}

