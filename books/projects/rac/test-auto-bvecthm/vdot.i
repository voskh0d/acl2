array<ui12, 5> partialsProducts8(ui8 b, array<int, 5> b_encs, bool bsigned) {

  array<ui12, 5> pps;
  int bval = bsigned ? int(si8(b)) : int(b);

  for (int i = 0; i < 5; i++) {
    ui12 pp = (1 << 9) + bval * b_encs[i] - (b_encs[i] < 0 ? 1 : 0);
    if (i != 0) {
      pp <<= 2;
      pp[0] = b_encs[i - 1] < 0;
    }
    pps[i] = pp;
  }
  return pps;
}

