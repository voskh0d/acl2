int encode8(ui9 src, int i, bool smul) {

  int res;
  switch (i) {
  case 0:
    res = src[0] - 2 * src[1];
    break;
  case 4:
    res = !smul && src[7];
    break;
  default:
    res = src[2 * i] + src[2 * i - 1] - 2 * src[2 * i + 1];
    break;
  }
  return res;
}

